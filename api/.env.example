DATABASE_URL=postgresql+psycopg://sukat:sukat@localhost:5432/sukat
CORS_ORIGINS=http://localhost:3000

# development | production. Anything except exactly "development" refuses the public
# JWT_SECRET below. If APP_ENV is missing, the API acts as production.
APP_ENV=development
# Sign JWTs with this. Generate one: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_DAYS=3650
INVITE_EXPIRE_HOURS=72
PASSWORD_RESET_EXPIRE_MINUTES=30
EMAIL_VERIFY_EXPIRE_HOURS=48
# Where the links in emails point. Set it to your real site on a server.
WEB_APP_URL=http://localhost:3000

# Failed login / invite-accept limits (per 15-minute window)
AUTH_FAILURE_WINDOW_MINUTES=15
AUTH_MAX_FAILURES_PER_EMAIL=10
AUTH_MAX_FAILURES_PER_IP=30
# Reset and confirmation emails, and signups, per 15-minute window
AUTH_EMAILS_MAX_PER_EMAIL=3
AUTH_EMAILS_MAX_PER_IP=20

# ----- Email -----
# console = print emails in the API terminal (development). smtp = really send them.
EMAIL_BACKEND=console
# Emails wait in the database; this background loop sends them and retries failures.
EMAIL_WORKER_ENABLED=true
EMAIL_POLL_SECONDS=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ----- Photo storage -----
# local = save uploads in LOCAL_UPLOAD_DIR (development). r2 = Cloudflare R2.
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads
# Where phones can reach this API (local upload URLs point here). Use your PC's LAN IP
# (e.g. http://192.168.1.10:8000) to test from a phone on the same Wi-Fi.
PUBLIC_API_URL=http://localhost:8000
UPLOAD_MAX_BYTES=5242880
UPLOAD_URL_EXPIRE_SECONDS=300
# Cloudflare R2 (needed when STORAGE_BACKEND=r2). Create an R2 API token with
# Object Read & Write on the bucket, and a CORS rule allowing PUT from the web origin.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ----- AI (reading list photos) -----
# gemini or anthropic: who reads photos and answers chat first (see app/ai/provider.py).
AI_PROVIDER=gemini
# Tried once if AI_PROVIDER times out, is rate limited, has a server error, or returns
# an invalid answer. none, gemini or anthropic. Must differ from AI_PROVIDER.
AI_FALLBACK_PROVIDER=anthropic
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=gemini-3.1-flash-lite
AI_FALLBACK_MODEL=claude-opus-5-5
# minimal is Gemini 3's lowest level. It cannot be switched fully off.
AI_GEMINI_THINKING_LEVEL=minimal
# Claude only (photo reading).
AI_EFFORT=medium
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=1
# Re-run on another model if a safety classifier declines. Set false for Haiku models.
AI_REFUSAL_FALLBACK=true
# USD per million tokens (for the cost log). Update these when you change AI_MODEL.
AI_PRICE_INPUT_PER_MTOK_USD=0.25
AI_PRICE_OUTPUT_PER_MTOK_USD=1.50
AI_PRICE_CACHE_WRITE_PER_MTOK_USD=0.25
AI_PRICE_CACHE_READ_PER_MTOK_USD=0.025
# The same prices for AI_FALLBACK_MODEL.
AI_FALLBACK_PRICE_INPUT_PER_MTOK_USD=4.00
AI_FALLBACK_PRICE_OUTPUT_PER_MTOK_USD=20.00
AI_FALLBACK_PRICE_CACHE_WRITE_PER_MTOK_USD=5.00
AI_FALLBACK_PRICE_CACHE_READ_PER_MTOK_USD=0.20
USD_TO_PHP=58.00
# Default AI spend per store per month, in centavos (50000 = 500 pesos).
AI_MONTHLY_BUDGET_CENTAVOS=50000

# ----- AI chat (the AI tab) -----
# Uses AI_MODEL above. Claude effort for chat answers (they're short lookups).
AI_CHAT_EFFORT=low
AI_CHAT_MAX_TOKENS=8000
# Time limit for one whole question, all model calls together (seconds).
AI_CHAT_TIMEOUT_SECONDS=45
CHAT_MAX_TOOL_CALLS=5
CHAT_QUESTIONS_PER_HOUR=30
CHAT_HISTORY_MESSAGES=10
