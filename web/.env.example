# Copy this file to .env.local and adjust.

# Used by the browser (home page health check).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Used by the Next.js server (route handlers, staff page). Optional: defaults to NEXT_PUBLIC_API_URL.
API_URL=http://localhost:8000

# Error reporting (Sentry). Off when empty. No personal data, cookies, headers or
# query strings are sent. SENTRY_DSN is for the server, NEXT_PUBLIC_SENTRY_DSN for the
# browser (it can be the same DSN). APP_ENV / NEXT_PUBLIC_APP_ENV name the environment.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development
