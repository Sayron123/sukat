# Copy this file to .env and adjust values.
DATABASE_URL=postgresql+psycopg://sukat:sukat@localhost:5432/sukat
CORS_ORIGINS=http://localhost:3000

# development | production (production refuses the default JWT_SECRET)
APP_ENV=development
# Sign JWTs with this. Generate one: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480
INVITE_EXPIRE_HOURS=72

# Failed login / invite-accept limits (per 15-minute window)
AUTH_FAILURE_WINDOW_MINUTES=15
AUTH_MAX_FAILURES_PER_EMAIL=10
AUTH_MAX_FAILURES_PER_IP=30
